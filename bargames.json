{
  "id": "buzzboard",
  "name": "Buzz Board",
  "kind": "game",
  "version": "0.1.1",
  "image": "ghcr.io/thezigpc/buzzboard:0.1.1",
  "port": 3007,
  "sdk": {
    "version": "0.13.0",
    "level": 3
  },
  "routes": {
    "player": "/",
    "table": "/room/{code}?role=table",
    "host": "/",
    "admin": "/admin"
  },
  "routing": {
    "basePath": true
  },
  "health": "/health",
  "events": [
    "room_created",
    "room_closed",
    "players_changed",
    "round_started",
    "round_ended",
    "winner",
    "game_over",
    "game_result"
  ],
  "commands": [
    "create_room",
    "start",
    "next_round",
    "end"
  ],
  "sessionKinds": [
    "venue",
    "patron"
  ],
  "brandable": [
    "displayName",
    "tagline",
    "accent"
  ],
  "resources": {
    "memory": "256m",
    "cpus": 1
  },
  "network": {
    "internet": false
  },
  "env": {
    "DATA_DIR": "/data"
  }
}
